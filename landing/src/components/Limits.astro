---
import { t, type Locale } from '../i18n/copy'
import DepthRuler from './DepthRuler.astro'
const { locale = 'en' } = Astro.props as { locale?: Locale }
const c = t(locale)
const base = import.meta.env.BASE_URL
---

<section class="stratum" id="limits">
  <DepthRuler locale={locale} index={1} />
  <div class="content">
    <h2>{c.limits.h2}</h2>
    <p class="lede">{c.limits.lede}</p>
    <div class="pair">
      <div class="content">
        <p>{c.limits.body}</p>
        <div class="gauges" role="list" aria-label={c.limits.gaugesLabel}>
          <div class="gauge" role="listitem">
            <div class="bars ok" aria-hidden="true"><i class="on" style="height:6px"></i><i class="on" style="height:11px"></i><i class="on" style="height:16px"></i><i style="height:22px"></i></div>
            <span>{c.limits.gaugeOk}</span>
          </div>
          <div class="gauge" role="listitem">
            <div class="bars warn" aria-hidden="true"><i class="on" style="height:6px"></i><i style="height:11px"></i><i style="height:16px"></i><i style="height:22px"></i></div>
            <span>{c.limits.gaugeWarn}</span>
          </div>
          <div class="gauge" role="listitem">
            <div class="bars low" aria-hidden="true"><i class="on" style="height:6px"></i><i style="height:11px"></i><i style="height:16px"></i><i style="height:22px"></i></div>
            <span>{c.limits.gaugeLow}</span>
          </div>
        </div>
        <p class="muted">{c.limits.glassNote}</p>
      </div>
      <figure>
        {/* A 2x (Retina) crop of the real menu bar item, shown at actual size
            via a 2x srcset descriptor: ring icon plus the quota-left title. */}
        <div class="bar-strip-shot"><img srcset={`${base}screenshots/menubar-ring.png 2x`} width="75" height="38" alt={c.limits.menuBarAlt} /></div>
        <figcaption>{c.limits.figcaption}</figcaption>
      </figure>
    </div>
  </div>
</section>
