---
import { t, type Locale } from '../i18n/copy'
import Install from './Install.astro'
const { locale = 'en' } = Astro.props as { locale?: Locale }
const c = t(locale)
---

<section class="hero" id="top">
  <div>
    <div class="greek" lang="grc">Σύρτις</div>
    <div class="gloss">{c.hero.gloss}</div>
    <h1>{c.hero.h1}</h1>
    <p class="lede">{c.hero.lede}</p>
    <Install locale={locale} />
    <p class="works">{c.hero.works}</p>
  </div>
  <figure class="shoal">
    <canvas id="sand" aria-label="Sand settling into strata and rising above the waterline, reshaped by the current"></canvas>
    <figcaption id="counter" aria-live="off"></figcaption>
  </figure>
</section>

<div class="strata" aria-hidden="true"><span></span><span></span><span></span><span></span></div>

<script>
  // Ported near-verbatim from the prototype's sand-shoal animation
  // (`.agent-local/syrtis/landing/template3.html`). The client-side
  // language switch is gone (this page is a single locale), so the counter
  // format string is derived from <html lang> instead of a runtime
  // COPY/UI lookup.
  ;(() => {
    const canvas = document.getElementById('sand') as HTMLCanvasElement | null
    const counter = document.getElementById('counter')
    if (!canvas || !counter) return
    const ctx = canvas.getContext('2d')!
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches
    const locale = document.documentElement.lang.startsWith('zh') ? 'zh' : 'en'
    const counterFmt = (n: string) =>
      locale === 'zh' ? `約 ${n} token 沉積・1 粒 = 1,000` : `≈ ${n} tokens settled · 1 grain = 1,000`
    const GRAIN = 3
    const TOKENS_PER_GRAIN = 1000
    const SURFACE = 0.66
    const WATER = 0.52
    const SPREAD = 0.14
    const PRESETTLE = 0.42
    const BAND = 520
    const FALL_RATE = 14
    const STEADY_RATE = 12
    const DRIFT_PERIOD = 2400
    const DRIFT_SPAN = 0.22
    let W: number, H: number, cols: number, stacks: number[][], heights: Int32Array, total: number, full: number,
      grains: { c: number; y: number; v: number }[], drift: { x: number; y: number; vx: number; life: number; tone: number }[],
      layer: HTMLCanvasElement, lctx: CanvasRenderingContext2D, settled: number, raf: number, frame: number, visible = true

    function sandTones() {
      const dark = (matchMedia('(prefers-color-scheme: dark)').matches && document.documentElement.dataset.theme !== 'light')
        || document.documentElement.dataset.theme === 'dark'
      return dark ? ['#C7A751', '#A98C45', '#D9BD74', '#8E7437', '#B89A55']
                  : ['#BD9F5F', '#A3854A', '#CDB57E', '#8C7040', '#B39455']
    }
    let tones = sandTones()
    const waterRGB = () => getComputedStyle(document.documentElement).getPropertyValue('--water').trim()

    function setup() {
      const r = canvas!.getBoundingClientRect()
      const dpr = Math.min(devicePixelRatio || 1, 2)
      W = Math.max(1, Math.floor(r.width)); H = Math.max(1, Math.floor(r.height))
      canvas!.width = W * dpr; canvas!.height = H * dpr
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
      cols = Math.ceil(W / GRAIN)
      heights = new Int32Array(cols)
      stacks = Array.from({ length: cols }, () => [])
      grains = []; drift = []; settled = 0; total = 0; frame = 0
      full = Math.round(SURFACE * H / GRAIN * SPREAD * cols * Math.sqrt(2 * Math.PI))
      layer = document.createElement('canvas'); layer.width = W * dpr; layer.height = H * dpr
      lctx = layer.getContext('2d')!; lctx.setTransform(dpr, 0, 0, dpr, 0, 0)
      tones = sandTones()
    }

    function centre() { return 0.54 + DRIFT_SPAN * Math.sin(frame / DRIFT_PERIOD * 2 * Math.PI) }
    function spawnX() {
      const u = Math.random() || 1e-6, v = Math.random()
      const g = Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v)
      return Math.min(cols - 1, Math.max(0, Math.round(cols * centre() + g * cols * SPREAD)))
    }
    function paint(c: number, h: number, tone: number) {
      lctx.fillStyle = tones[tone]
      lctx.globalAlpha = 0.82 + Math.random() * 0.18
      lctx.fillRect(c * GRAIN, H - (h + 1) * GRAIN, GRAIN, GRAIN)
    }
    function settle(c: number, tone: number) {
      for (let k = 0; k < 6; k++) {
        const l = c > 0 ? heights[c - 1] : Infinity, r = c < cols - 1 ? heights[c + 1] : Infinity
        if (l < heights[c] - 1 && l <= r) c--; else if (r < heights[c] - 1) c++; else break
      }
      const h = heights[c]++
      stacks[c].push(tone)
      paint(c, h, tone)
      total++
    }
    function deposit(c: number) {
      settle(c, Math.floor(settled / BAND) % tones.length)
      settled++
    }
    function lift() {
      let r = Math.random() * total, c = 0
      while (c < cols - 1 && r >= heights[c]) { r -= heights[c]; c++ }
      if (!heights[c]) return
      const h = --heights[c]
      const tone = stacks[c].pop()!
      total--
      lctx.clearRect(c * GRAIN, H - (h + 1) * GRAIN, GRAIN, GRAIN)
      const dir = Math.cos(frame / DRIFT_PERIOD * 2 * Math.PI) >= 0 ? 1 : -1
      drift.push({ x: c * GRAIN, y: H - (h + 1) * GRAIN, vx: dir * (0.6 + Math.random()), life: 45, tone })
    }

    function step() {
      const n = total >= full ? STEADY_RATE : FALL_RATE
      for (let i = 0; i < n; i++) grains.push({ c: spawnX(), y: -Math.random() * 40, v: 2.4 + Math.random() * 2 })
      for (let i = grains.length - 1; i >= 0; i--) {
        const g = grains[i]; g.y += g.v
        if (g.y >= H - (heights[g.c] + 1) * GRAIN) { deposit(g.c); grains.splice(i, 1) }
      }
      while (total > full) lift()
      for (let i = drift.length - 1; i >= 0; i--) {
        const d = drift[i]; d.x += d.vx; d.y -= 0.15; d.life--
        if (d.life <= 0 || d.x < 0 || d.x > W) drift.splice(i, 1)
      }
      frame++
    }

    let lastText = ''
    function draw() {
      ctx.clearRect(0, 0, W, H)
      const wy = H * WATER, water = waterRGB()
      ctx.fillStyle = `rgba(${water}, 0.07)`; ctx.fillRect(0, wy, W, H - wy)
      ctx.globalAlpha = 1; ctx.drawImage(layer, 0, 0, W, H)
      ctx.fillStyle = tones[2]; ctx.globalAlpha = 0.55
      for (const g of grains) ctx.fillRect(g.c * GRAIN, g.y, GRAIN, GRAIN)
      ctx.globalAlpha = 1
      for (const d of drift) { ctx.globalAlpha = d.life / 45 * 0.7; ctx.fillStyle = tones[d.tone]; ctx.fillRect(d.x, d.y, GRAIN, GRAIN) }
      ctx.globalAlpha = 1
      ctx.fillStyle = `rgba(${water}, 0.10)`; ctx.fillRect(0, wy, W, H - wy)
      ctx.strokeStyle = `rgba(${water}, 0.55)`; ctx.lineWidth = 1
      ctx.beginPath(); ctx.moveTo(0, wy + 0.5); ctx.lineTo(W, wy + 0.5); ctx.stroke()
      const n = new Intl.NumberFormat(locale === 'zh' ? 'zh-TW' : 'en', { notation: 'compact', minimumFractionDigits: 1, maximumFractionDigits: 1 }).format(settled * TOKENS_PER_GRAIN)
      const text = counterFmt(n)
      if (text !== lastText) { counter!.textContent = text; lastText = text }
    }

    function loop() {
      if (!visible) { raf = 0; return }
      step(); draw()
      raf = requestAnimationFrame(loop)
    }

    function presettle(share: number) {
      const target = full * share
      while (total < target) deposit(spawnX())
    }

    function start() {
      cancelAnimationFrame(raf)
      setup()
      if (reduce) { presettle(1); draw(); return }
      presettle(PRESETTLE)
      const ff = Math.min(20000, +new URLSearchParams(location.search).get('ff')! || 0)
      for (let i = 0; i < ff; i++) step()
      draw()
      raf = requestAnimationFrame(loop)
    }

    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting
      if (visible && !reduce && !raf) raf = requestAnimationFrame(loop)
    }).observe(canvas)

    let t: ReturnType<typeof setTimeout>, lastW = innerWidth
    addEventListener('resize', () => {
      if (innerWidth === lastW) return; lastW = innerWidth
      clearTimeout(t); t = setTimeout(start, 200)
    })
    start()
  })()
</script>
