---
// Platform-switched install block: macOS is Homebrew-only (no GitHub
// Releases download — ad-hoc signed, not notarized, until the post-v2.0
// signing PR), Windows gets the two Syrtis-Windows installers plus Scoop.
// Rendered twice per page (hero + closing); pre-selected by the visitor's
// OS client-side, default macOS when unknown, matching the prototype.
import { t, type Locale } from '../i18n/copy'
const { locale = 'en' } = Astro.props as { locale?: Locale }
const c = t(locale).install
---

<div class="install">
  <div class="seg os-switch" role="tablist" aria-label="Platform">
    <button type="button" role="tab" data-os="mac">macOS</button>
    <button type="button" role="tab" data-os="win">Windows</button>
  </div>
  <div class="panel" role="tabpanel" data-panel="mac">
    <div class="cmd">
      <code>brew install --cask nanako0129/tap/syrtis</code>
      <button type="button" class="btn" data-copy data-copy-label={c.copy} data-copied-label={c.copied} data-selected-label={c.selected}>{c.copy}</button>
    </div>
    <span class="copied-hint" aria-live="polite"></span>
    <span class="note">{c.macNote}</span>
  </div>
  <div class="panel" role="tabpanel" data-panel="win" hidden>
    <div class="btns">
      <a class="btn" href="https://github.com/Nanako0129/Syrtis-Windows/releases/latest/download/Nyanako.Syrtis-win-x64-Setup.exe">{c.winX64}</a>
      <a class="btn ghost" href="https://github.com/Nanako0129/Syrtis-Windows/releases/latest/download/Nyanako.Syrtis-win-arm64-Setup.exe">{c.winArm64}</a>
    </div>
    <span class="note">{c.winNote}</span>
    <div class="cmd">
      <code>{`scoop bucket add syrtis https://github.com/Nanako0129/Syrtis-Windows\nscoop install syrtis`}</code>
      <button type="button" class="btn" data-copy data-copy-label={c.copy} data-copied-label={c.copied} data-selected-label={c.selected}>{c.copy}</button>
    </div>
    <span class="copied-hint" aria-live="polite"></span>
  </div>
</div>

<script>
  // OS pre-selection (default macOS when unknown) shared across every
  // `.install` instance on the page via one `data-os` state, persisted to
  // localStorage so hero and closing panels — and repeat visits — agree.
  // Ported from the prototype; the language half of its state is gone since
  // this page is a single locale.
  ;(() => {
    const nav = navigator as Navigator & { userAgentData?: { platform?: string } }
    let os: 'mac' | 'win' = /Win/i.test(nav.userAgentData?.platform || navigator.platform || '') ? 'win' : 'mac'
    try {
      const saved = JSON.parse(localStorage.getItem('syrtis-os') || '{}')
      if (saved.os === 'mac' || saved.os === 'win') os = saved.os
    } catch {}

    function render() {
      document.querySelectorAll<HTMLElement>('[data-os]').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.os === os)))
      document.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => { p.hidden = p.dataset.panel !== os })
      try { localStorage.setItem('syrtis-os', JSON.stringify({ os })) } catch {}
    }
    document.querySelectorAll<HTMLElement>('[data-os]').forEach((b) =>
      b.addEventListener('click', () => { os = b.dataset.os as 'mac' | 'win'; render() }),
    )
    render()

    // Copy a command; where the clipboard is refused, select it and say so.
    document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const code = btn.parentElement!.querySelector('code')!
        const hint = btn.closest('.panel')!.querySelector('.copied-hint')!
        const copiedLabel = btn.dataset.copiedLabel!, copyLabel = btn.dataset.copyLabel!
        navigator.clipboard.writeText(code.textContent || '').then(() => {
          btn.textContent = copiedLabel; hint.textContent = ''
          setTimeout(() => { btn.textContent = copyLabel }, 1600)
        }).catch(() => {
          const r = document.createRange(); r.selectNodeContents(code)
          const s = getSelection(); s?.removeAllRanges(); s?.addRange(r)
          hint.textContent = btn.dataset.selectedLabel || ''
        })
      })
    })
  })()
</script>
