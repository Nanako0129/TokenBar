---
import { t, type Locale } from '../i18n/copy'
import DepthRuler from './DepthRuler.astro'
const { locale = 'en' } = Astro.props as { locale?: Locale }
const c = t(locale)
---

<section class="stratum" id="resets">
  <DepthRuler locale={locale} index={2} />
  <div class="content">
    <h2>{c.resets.h2}</h2>
    <blockquote><span>{c.resets.quote}</span><cite>{c.resets.cite}</cite></blockquote>
    <p class="lede">{c.resets.lede}</p>
    <figure style="max-width:34rem">
      <div class="pending"><div><b>{c.lensName.quota}</b><span>{c.pending}</span></div></div>
      <figcaption>{c.resets.figcaption}</figcaption>
    </figure>
  </div>
</section>
