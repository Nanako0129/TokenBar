---
// Hero and footer both name the two platforms (requirement 1). No macOS
// download link — Homebrew is the only macOS install path until the
// post-v2.0 signing PR; the footer's "Source (macOS)" link points at the
// repo itself, never `${repo}/releases`.
import { t, type Locale } from '../i18n/copy'
const { locale = 'en' } = Astro.props as { locale?: Locale }
const c = t(locale)
const essayHref = 'https://claude.ai/code/artifact/d095bcac-5cd9-4642-b642-5e3292c76159'
---

<footer>
  <span><span>{c.footer.text}</span><br /><span>{c.footer.platforms}</span></span>
  <nav aria-label="Links">
    <a href="https://github.com/Nanako0129/TokenBar">{c.footer.mac}</a>
    <a href="https://github.com/Nanako0129/Syrtis-Windows">{c.footer.win}</a>
    <a href={essayHref}>{c.footer.essay}</a>
  </nav>
</footer>
