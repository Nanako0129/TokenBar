---
import { t, type Locale } from '../i18n/copy'
const { locale = 'en' } = Astro.props as { locale?: Locale }
const c = t(locale)
---

<section class="stratum" id="privacy">
  <div class="ruler" aria-hidden="true"></div>
  <div class="content">
    <h2>{c.privacy.h2}</h2>
    <div class="pillars">
      <div class="pillar"><h3>{c.privacy.p1t}</h3><p>{c.privacy.p1b}</p></div>
      <div class="pillar"><h3>{c.privacy.p2t}</h3><p>{c.privacy.p2b}</p></div>
      <div class="pillar"><h3>{c.privacy.p3t}</h3><p>{c.privacy.p3b}</p></div>
    </div>
  </div>
</section>
