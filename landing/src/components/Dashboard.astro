---
// Lens order is the app's own tab order: `AppView` in
// Sources/TokenBar/DashboardModel.swift (`case overview, quota, models,
// monthly, daily, hourly, stats, agents`). Neither this list nor the CSS
// hardcodes the count — `--lens-count` below reads `LENS_ORDER.length`.
import { t, LENS_ORDER, type Locale, type LensId } from '../i18n/copy'
import DepthRuler from './DepthRuler.astro'
const { locale = 'en' } = Astro.props as { locale?: Locale }
const c = t(locale)
const base = import.meta.env.BASE_URL

// Captures of the renamed v2.0 build, one set per locale so each page shows
// its own UI language: `public/screenshots/{en,zh-tw}/<lens>.webp`. The map
// stays partial so a lens without a capture falls back to the pending panel.
const shotDir = `${base}screenshots/${locale}/`
// The captures are 2x (Retina) pixels. They are referenced by `srcset` with a
// `2x` descriptor and no `src`: when `src` names the same file, Chrome takes
// it as the 1x candidate and lays the image out at full pixel size on 1x
// screens (measured: 760 px wide instead of 380).
const shots: Partial<Record<LensId, string>> = {
  overview: 'overview.webp',
  quota: 'quota.webp',
  models: 'models.webp',
  monthly: 'monthly.webp',
  daily: 'daily.webp',
  hourly: 'hourly.webp',
  stats: 'stats.webp',
  agents: 'agents.webp',
}
---

<section class="stratum" id="dashboard">
  <DepthRuler locale={locale} index={0} />
  <div class="content">
    <h2>{c.dashboard.h2}</h2>
    <p class="lede">{c.dashboard.lede}</p>
    <figure>
      <div class="shot"><img srcset={`${shotDir}contribution-3d.webp` + " 2x"} alt={c.dashboard.contributionAlt} loading="lazy" /></div>
      <figcaption>{c.dashboard.figcaption}</figcaption>
    </figure>
    <div class="scrolly" style={`--lens-count:${LENS_ORDER.length}`}>
      <div class="pin">
        <div class="explorer">
          <h3>{c.dashboard.explorerH3}</h3>
          <div class="lenses" role="tablist" aria-label={c.dashboard.lensesLabel}>
            {LENS_ORDER.map((id, i) => (
              <button type="button" role="tab" id={`lens-tab-${id}`} aria-controls={`lens-panel-${id}`} class="lens" data-lens={id} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
                <b>{c.lensName[id]}</b>
                <span>{c.lens[id]}</span>
              </button>
            ))}
          </div>
          <figure class="lensshot">
            <div class="stack" id="lensstack">
              {LENS_ORDER.map((id, i) => (
                shots[id] ? (
                  <div class:list={['shot', { front: i === 0 }]} data-lens-panel={id} id={`lens-panel-${id}`} role="tabpanel" aria-labelledby={`lens-tab-${id}`} aria-hidden={i === 0 ? 'false' : 'true'}>
                    <img srcset={`${shotDir}${shots[id]}` + " 2x"} alt={c.lensName[id]} loading={i === 0 ? 'eager' : 'lazy'} />
                  </div>
                ) : (
                  <div class:list={['pending', { front: i === 0 }]} data-lens-panel={id} id={`lens-panel-${id}`} role="tabpanel" aria-labelledby={`lens-tab-${id}`} aria-hidden={i === 0 ? 'false' : 'true'}>
                    <div><b>{c.lensName[id]}</b><span>{c.pending}</span></div>
                  </div>
                )
              ))}
            </div>
          </figure>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Scroll-pinned lens explorer: the list picks which pre-rendered panel is
  // visible. Ported from the prototype, simplified — the prototype built
  // each panel's DOM on the fly from a COPY/SHOTS object at runtime; here
  // every panel already exists in the server-rendered markup (one per
  // locale), so this script only ever toggles a `.front` class and updates
  // `aria-selected`/`--p`, it never creates elements.
  ;(() => {
    const lenses = [...document.querySelectorAll<HTMLElement>('.lens')]
    const stack = document.getElementById('lensstack')
    if (!lenses.length || !stack) return
    const panels = [...stack.querySelectorAll<HTMLElement>('[data-lens-panel]')]
    let current: HTMLElement | null = null

    function activate(b: HTMLElement) {
      if (b === current) return
      current = b
      lenses.forEach((x) => { x.setAttribute('aria-selected', String(x === b)); x.tabIndex = x === b ? 0 : -1 })
      panels.forEach((p) => {
        const active = p.dataset.lensPanel === b.dataset.lens
        p.classList.toggle('front', active)
        p.setAttribute('aria-hidden', String(!active))
      })
    }

    const scrolly = document.querySelector<HTMLElement>('.scrolly')!
    const pinned = matchMedia('(min-width: 861px)')
    function progress() {
      const r = scrolly.getBoundingClientRect()
      return Math.min(1, Math.max(0, -r.top / Math.max(1, r.height - innerHeight)))
    }
    // Narrow screens: the screenshot is stuck above the list, so the lens
    // whose row has scrolled up to a line just below it is the selected
    // one. Ported verbatim from the prototype's 2026-09-26 mobile fix.
    const shotBox = document.querySelector('.lensshot')!
    function syncStacked() {
      const below = shotBox.getBoundingClientRect().bottom
      const line = below + (innerHeight - below) * 0.35
      const tops = lenses.map((b) => b.getBoundingClientRect().top)
      if (tops[0] > innerHeight || lenses[lenses.length - 1].getBoundingClientRect().bottom < 0) return
      let i = 0
      tops.forEach((top, k) => { if (top <= line) i = k })
      activate(lenses[i])
      const end = i + 1 < tops.length ? tops[i + 1] : lenses[i].getBoundingClientRect().bottom
      lenses[i].style.setProperty('--p', String(Math.min(1, Math.max(0, (line - tops[i]) / Math.max(1, end - tops[i])))))
    }
    function sync() {
      if (!pinned.matches) return syncStacked()
      const steps = progress() * lenses.length
      const i = Math.min(lenses.length - 1, Math.floor(steps))
      activate(lenses[i])
      lenses[i].style.setProperty('--p', String(i === lenses.length - 1 && steps >= lenses.length ? 1 : steps - i))
    }
    let ticking = false
    addEventListener('scroll', () => {
      if (ticking) return; ticking = true
      requestAnimationFrame(() => { ticking = false; sync() })
    }, { passive: true })

    lenses.forEach((b, i) => {
      b.addEventListener('click', () => {
        activate(b)
        if (!pinned.matches) return
        const top = scrolly.getBoundingClientRect().top + scrollY
        const span = scrolly.offsetHeight - innerHeight
        scrollTo({ top: top + span * (i + 0.5) / lenses.length })
      })
      b.addEventListener('keydown', (e) => {
        const k = ({ ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 } as Record<string, number>)[e.key]
        if (!k) return
        e.preventDefault()
        const n = lenses[(i + k + lenses.length) % lenses.length]
        n.focus(); n.click()
      })
    })

    activate(lenses[0])
    sync()
  })()
</script>
