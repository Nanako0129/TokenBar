---
// fonts are self-hosted (fontsource) so first paint never blocks on a
// third-party stylesheet, matching the prototype's --display/--sans/--mono
// stack (GFS Didot / Hanken Grotesk / JetBrains Mono). GFS Didot is a new
// dependency: the prototype specifies it for every heading and the site had
// no serif display font before, so it is unavoidable for a faithful port.
import '@fontsource/gfs-didot'
import '@fontsource-variable/hanken-grotesk'
import '@fontsource-variable/jetbrains-mono'
import '../styles/global.css'
import { t, type Locale } from '../i18n/copy'

interface Props {
  title?: string
  description?: string
  locale?: Locale
  /** Path under each locale's root, e.g. 'why-syrtis/', so hreflang pairs the same page. */
  path?: string
}

const { locale = 'en', path = '' } = Astro.props
const meta = t(locale).meta
const { title = meta.title, description = meta.description } = Astro.props

const base = import.meta.env.BASE_URL
const canonical = new URL(Astro.url.pathname, Astro.site).href
// versioned brand card (1200×630) — bump the filename on every redesign:
// social platforms cache scrapes per image URL and a fresh name is the only
// reliable bust (og.png / og-card.png stay for already-shared links). The
// asset itself is unchanged by this PR — Syrtis brand assets are PR C's scope.
const ogImage = new URL(`${base}og-card-v4.png`, Astro.site).href
const ogImageAlt = 'Syrtis — where your tokens settle, tracked from the macOS menu bar'

const enUrl = new URL(`${base}${path}`, Astro.site).href
const zhUrl = new URL(`${base}zh-tw/${path}`, Astro.site).href

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Syrtis',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'macOS 14+ (Apple Silicon); Windows x64/ARM64',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  description,
  url: canonical,
  screenshot: new URL(`${base}screenshots/en/overview.webp`, Astro.site).href,
  license: 'https://opensource.org/licenses/MIT',
}
---

<!doctype html>
<html lang={meta.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}favicon.png`} />

    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="zh-Hant-TW" href={zhUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Syrtis" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="theme-color" content="#F3F5F4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0B1514" media="(prefers-color-scheme: dark)" />
    <meta property="og:locale" content={meta.ogLocale} />
    <meta property="og:locale:alternate" content={locale === 'en' ? 'zh_TW' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <div class="wrap">
      <slot />
    </div>
  </body>
</html>
