---
// Self-hosted, weight 400 only, imported on this page alone: iPhone has no
// Songti TC and the site never loaded Noto Serif TC before, so zh headings
// fell back to a generic serif on phones (2026-09-26 mobile feedback). The
// English page's bundle never pulls this in, since it has no :lang(zh-Hant)
// text to need it for.
import '@fontsource/noto-serif-tc/400.css'
import Base from '../../layouts/Base.astro'
import Bar from '../../components/Bar.astro'
import Hero from '../../components/Hero.astro'
import Dashboard from '../../components/Dashboard.astro'
import Limits from '../../components/Limits.astro'
import Resets from '../../components/Resets.astro'
import Privacy from '../../components/Privacy.astro'
import NameSection from '../../components/NameSection.astro'
import ClosingInstall from '../../components/ClosingInstall.astro'
import Footer from '../../components/Footer.astro'
---

<Base locale="zh-tw">
  <Bar locale="zh-tw" />
  <Hero locale="zh-tw" />
  <Dashboard locale="zh-tw" />
  <Limits locale="zh-tw" />
  <Resets locale="zh-tw" />
  <Privacy locale="zh-tw" />
  <NameSection locale="zh-tw" />
  <ClosingInstall locale="zh-tw" />
  <Footer locale="zh-tw" />
</Base>
